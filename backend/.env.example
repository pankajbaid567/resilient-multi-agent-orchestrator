# Application metadata
APP_NAME=Reliable AI Agent API
APP_ENV=development
APP_DEBUG=false

# API server binding
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins (e.g. frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis state/checkpoint storage URL
REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=86400

# Open-source model provider key (required)
# Example provider: Hugging Face Router (OpenAI-compatible API)
OPEN_SOURCE_API_KEY=your_open_source_api_key
OPEN_SOURCE_BASE_URL=https://router.huggingface.co/v1

# Legacy provider keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web search provider key
TAVILY_API_KEY=your_tavily_api_key

# Model selection and fallback chain
PRIMARY_MODEL=meta-llama/Llama-3.1-8B-Instruct
FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct
VALIDATION_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Execution controls
MAX_RETRIES=3
STEP_TIMEOUT=60
MAX_STEPS=15
# 0 means auto-derive from MAX_STEPS.
GRAPH_RECURSION_LIMIT=0

# Embedding model for vector memory retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Security switches (off by default; see README "Security defaults")
ENABLE_CODE_EXEC=false
ENABLE_API_CALL=false
# Required to change runtime settings via POST /config*; leave empty for a read-only deployment
ADMIN_API_KEY=

# Models: any OpenAI-compatible endpoint. Examples (free tiers change; check the provider):
#   Hugging Face router: OPEN_SOURCE_BASE_URL=https://router.huggingface.co/v1
#   Gemini API:          OPEN_SOURCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:                OPEN_SOURCE_BASE_URL=https://api.groq.com/openai/v1
MODEL_CHAIN=
LLM_SEND_TEMPERATURE=true
# Multi-agent and graph runtime
SUPERVISOR_MODE=llm
MAX_AGENT_TOOL_CALLS=3
MAX_TOTAL_REFLECTIONS=5
CHECKPOINT_URL=memory
TASK_TOKEN_BUDGET=60000
TASK_DEADLINE_SECONDS=600
