# -----------------------------
# Core API keys (required)
# -----------------------------
OPEN_SOURCE_API_KEY=your_open_source_api_key
OPEN_SOURCE_BASE_URL=https://openrouter.ai/api/v1
TAVILY_API_KEY=your_tavily_api_key

# Legacy provider keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------
# Backend runtime configuration
# -----------------------------
REDIS_URL=redis://redis:6379/0
PRIMARY_MODEL=meta-llama/llama-3.1-8b-instruct:free
FALLBACK_MODEL=qwen/qwen-2.5-7b-instruct:free
VALIDATION_MODEL=qwen/qwen-2.5-7b-instruct:free

MAX_RETRIES=3
STEP_TIMEOUT=60
MAX_STEPS=15
# 0 means auto-derive from MAX_STEPS.
GRAPH_RECURSION_LIMIT=0
PARALLEL_MODE=true
MULTI_AGENT_MODE=true
MAX_CONCURRENT_STEPS=3
CHAOS_MODE=false
LOG_LEVEL=INFO

# -----------------------------
# Optional app metadata
# -----------------------------
APP_NAME=Reliable AI Agent API
APP_ENV=development
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional memory and embedding settings
REDIS_TTL_SECONDS=86400
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------
# Frontend runtime configuration
# -----------------------------
VITE_API_URL=http://localhost:8000
# Security switches (off by default; see README "Security defaults")
ENABLE_CODE_EXEC=false
ENABLE_API_CALL=false
# Required to change runtime settings via POST /config*; leave empty for a read-only deployment
ADMIN_API_KEY=

# Models: any OpenAI-compatible endpoint. Examples (free tiers change; check the provider):
#   Hugging Face router: OPEN_SOURCE_BASE_URL=https://router.huggingface.co/v1
#   Gemini API:          OPEN_SOURCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:                OPEN_SOURCE_BASE_URL=https://api.groq.com/openai/v1
MODEL_CHAIN=
LLM_SEND_TEMPERATURE=true
# Multi-agent and graph runtime
SUPERVISOR_MODE=llm
MAX_AGENT_TOOL_CALLS=3
MAX_TOTAL_REFLECTIONS=5
CHECKPOINT_URL=memory
TASK_TOKEN_BUDGET=60000
TASK_DEADLINE_SECONDS=600
# Observability: OpenTelemetry spans (task, node, step, agent, model call, tool call)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # e.g. local Jaeger, or a hosted OTLP endpoint
# OTEL_EXPORTER_OTLP_HEADERS=                          # auth headers if the backend needs them
OTEL_SERVICE_NAME=reliable-agent
OTEL_CONSOLE_EXPORT=false
# Cost is reported only for priced models: {"model": [usd_per_1M_input, usd_per_1M_output]}
MODEL_PRICES=
# Ablation switches (used by the eval baselines)
ENABLE_REFLECTION=true
ENABLE_CIRCUIT_BREAKER=true
